<mxfile host="app.diagrams.net">
  <diagram id="aws-bedrock-architecture-v2" name="AWS Bedrock Architecture">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>

        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ====================================================== -->
        <!-- Outside AWS -->
        <!-- ====================================================== -->

        <mxCell id="outsideTitle"
          value="Client"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#444444;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="wpf"
          value="WPF Desktop App&#xa;&#xa;・保守キー保持&#xa;・JWT保持&#xa;・Job送信&#xa;・結果ポーリング"
          style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="210" height="150" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- AWS Cloud Boundary -->
        <!-- ====================================================== -->

        <mxCell id="awsCloud"
          value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#879196;strokeWidth=2;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="1400" height="870" as="geometry"/>
        </mxCell>

        <mxCell id="awsTitle"
          value="AWS Cloud"
          style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="65" width="200" height="35" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Lane 1 : Authentication -->
        <!-- ====================================================== -->

        <mxCell id="authLane"
          value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;"
          vertex="1" parent="1">
          <mxGeometry x="590" y="110" width="1070" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="authLaneTitle"
          value="① Authentication"
          style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#4A4A4A;"
          vertex="1" parent="1">
          <mxGeometry x="610" y="125" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Auth Lambda -->
        <mxCell id="authLambdaIcon"
          value="AWS Lambda&#xa;Auth Lambda"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="780" y="175" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="authLambdaNote"
          value="保守キー照合&#xa;顧客・契約状態確認&#xa;JWT発行"
          style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="735" y="270" width="170" height="50" as="geometry"/>
        </mxCell>

        <!-- Customer DynamoDB -->
        <mxCell id="customerDbIcon"
          value="Amazon DynamoDB&#xa;Customer / Maintenance"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;"
          vertex="1" parent="1">
          <mxGeometry x="1120" y="175" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="customerDbNote"
          value="maintenanceKey&#xa;maintenanceId&#xa;customerId / enabled"
          style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="1070" y="270" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Shared API Gateway -->
        <!-- ====================================================== -->

        <mxCell id="apiIcon"
          value="Amazon API Gateway"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;"
          vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="88" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="apiEndpoints"
          value="POST /auth&#xa;POST /jobs&#xa;GET /jobs/{jobId}"
          style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="385" y="525" width="160" height="65" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Lane 2 : Job Submission -->
        <!-- ====================================================== -->

        <mxCell id="jobLane"
          value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;"
          vertex="1" parent="1">
          <mxGeometry x="590" y="350" width="1070" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="jobLaneTitle"
          value="② Job Submission"
          style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#4A4A4A;"
          vertex="1" parent="1">
          <mxGeometry x="610" y="365" width="200" height="25" as="geometry"/>
        </mxCell>

        <!-- Authorizer -->
        <mxCell id="authorizerIcon"
          value="AWS Lambda&#xa;Authorizer"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="690" y="420" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="authorizerNote"
          value="JWT署名・有効期限検証&#xa;customerId取得"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="645" y="515" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- Job Submit -->
        <mxCell id="submitLambdaIcon"
          value="AWS Lambda&#xa;Job Submit"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="submitLambdaNote"
          value="jobId生成&#xa;status = QUEUED&#xa;202 Accepted"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="860" y="515" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- Jobs DynamoDB -->
        <mxCell id="jobDbIcon"
          value="Amazon DynamoDB&#xa;BedrockJobs"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;"
          vertex="1" parent="1">
          <mxGeometry x="1160" y="420" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="jobDbNote"
          value="jobId / customerId&#xa;status / input / result&#xa;errorMessage"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="1110" y="515" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Lane 3 : Async Processing -->
        <!-- ====================================================== -->

        <mxCell id="asyncLane"
          value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;"
          vertex="1" parent="1">
          <mxGeometry x="590" y="610" width="1070" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="asyncLaneTitle"
          value="③ Async Processing / Result Retrieval"
          style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#4A4A4A;"
          vertex="1" parent="1">
          <mxGeometry x="610" y="625" width="330" height="25" as="geometry"/>
        </mxCell>

        <!-- Job Get Lambda -->
        <mxCell id="getLambdaIcon"
          value="AWS Lambda&#xa;Job Get"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="690" y="700" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="getLambdaNote"
          value="customerId照合&#xa;status / result返却"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="645" y="795" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- SQS -->
        <mxCell id="sqsIcon"
          value="Amazon SQS&#xa;Job Queue"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="700" width="78" height="78" as="geometry"/>
        </mxCell>

        <!-- Worker -->
        <mxCell id="workerIcon"
          value="AWS Lambda&#xa;Worker"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;"
          vertex="1" parent="1">
          <mxGeometry x="1210" y="700" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="workerNote"
          value="PROCESSING&#xa;Bedrock呼出し&#xa;SUCCEEDED / FAILED"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="1165" y="795" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrockIcon"
          value="Amazon Bedrock"
          style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4AB29A;gradientDirection=north;fillColor=#116D5B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;"
          vertex="1" parent="1">
          <mxGeometry x="1460" y="700" width="78" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="bedrockNote"
          value="Converse / InvokeModel&#xa;最大 約3分"
          style="text;html=1;align=center;fontSize=11;fontColor=#555555;"
          vertex="1" parent="1">
          <mxGeometry x="1415" y="795" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- DLQ -->
        <mxCell id="dlq"
          value="DLQ&#xa;一定回数失敗したJob"
          style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#F4F4F4;strokeColor=#777777;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="1190" y="865" width="150" height="45" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Edges -->
        <!-- ====================================================== -->

        <!-- WPF to API Gateway -->
        <mxCell id="edgeWpfApi"
          value="HTTPS&#xa;① POST /auth&#xa;② POST /jobs&#xa;③ GET /jobs/{jobId}"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="wpf" target="apiIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- API to Auth -->
        <mxCell id="edgeApiAuth"
          value="POST /auth"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="apiIcon" target="authLambdaIcon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="460"/>
              <mxPoint x="550" y="215"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Auth to Customer DB -->
        <mxCell id="edgeAuthDb"
          value="保守キー照合"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="authLambdaIcon" target="customerDbIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- API to Authorizer -->
        <mxCell id="edgeApiAuthorizer"
          value="JWT"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="apiIcon" target="authorizerIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Authorizer to Submit -->
        <mxCell id="edgeAuthorizerSubmit"
          value="認証OK"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="authorizerIcon" target="submitLambdaIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Submit to Job DB -->
        <mxCell id="edgeSubmitDb"
          value="Job登録&#xa;QUEUED"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="submitLambdaIcon" target="jobDbIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Submit to SQS -->
        <mxCell id="edgeSubmitSqs"
          value="jobId"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="submitLambdaIcon" target="sqsIcon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="460"/>
              <mxPoint x="1000" y="650"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- SQS to Worker -->
        <mxCell id="edgeSqsWorker"
          value="非同期実行"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="sqsIcon" target="workerIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Worker to Bedrock -->
        <mxCell id="edgeWorkerBedrock"
          value="Converse / InvokeModel"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="workerIcon" target="bedrockIcon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Worker to Job DB -->
        <mxCell id="edgeWorkerJobDb"
          value="status / result更新"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="workerIcon" target="jobDbIcon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1340" y="740"/>
              <mxPoint x="1340" y="590"/>
              <mxPoint x="1200" y="590"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- API to Job Get -->
        <mxCell id="edgeApiGet"
          value="GET /jobs/{jobId}"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="apiIcon" target="getLambdaIcon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="460"/>
              <mxPoint x="550" y="740"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Get Lambda to Job DB -->
        <mxCell id="edgeGetDb"
          value="Job取得&#xa;customerId照合"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1" source="getLambdaIcon" target="jobDbIcon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="740"/>
              <mxPoint x="840" y="590"/>
              <mxPoint x="1130" y="590"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Worker to DLQ -->
        <mxCell id="edgeWorkerDlq"
          value="一定回数失敗"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1;dashed=1;endArrow=block;endFill=1;"
          edge="1" parent="1" source="workerIcon" target="dlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ====================================================== -->
        <!-- Notes -->
        <!-- ====================================================== -->

        <mxCell id="jwtResponseNote"
          value="Response: 200 OK + JWT"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0B24A;"
          vertex="1" parent="1">
          <mxGeometry x="1320" y="165" width="190" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="jobResponseNote"
          value="Response: 202 Accepted + jobId"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0B24A;"
          vertex="1" parent="1">
          <mxGeometry x="1380" y="415" width="210" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="getResponseNote"
          value="Response: 200 OK&#xa;QUEUED / PROCESSING / SUCCEEDED / FAILED"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0B24A;"
          vertex="1" parent="1">
          <mxGeometry x="620" y="850" width="300" height="50" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>