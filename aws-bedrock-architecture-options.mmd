    subgraph C["C. REST API + Streaming"]
        C1[".NET Desktop App"]
        C2["API Gateway REST API"]
        C3["AWS Lambda"]
        C4["Python API Application"]
        C5["Amazon Bedrock Streaming"]

        C1 --> C2
        C2 --> C3
        C3 --> C4
