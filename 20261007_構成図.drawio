<mxfile host="app.diagrams.net">
  <diagram name="AWS Bedrock Architecture" id="aws-bedrock-architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- WPF -->
        <mxCell id="wpf" value="WPF Desktop App&#xa;&#xa;・保守キー送信&#xa;・JWT保持&#xa;・Job登録&#xa;・Job状態ポーリング"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="190" height="150" as="geometry"/>
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="api" value="Amazon API Gateway&#xa;&#xa;POST /auth&#xa;POST /jobs&#xa;GET /jobs/{jobId}"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="210" height="170" as="geometry"/>
        </mxCell>

        <!-- Auth Lambda -->
        <mxCell id="authLambda" value="Auth Lambda&#xa;&#xa;・保守キー照合&#xa;・顧客照合&#xa;・JWT発行"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="190" height="120" as="geometry"/>
        </mxCell>

        <!-- Customer DB -->
        <mxCell id="customerDb" value="DynamoDB&#xa;Customer / Maintenance&#xa;&#xa;・maintenanceId&#xa;・maintenanceKey&#xa;・customerId&#xa;・enabled"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="930" y="70" width="210" height="140" as="geometry"/>
        </mxCell>

        <!-- Authorizer -->
        <mxCell id="authorizer" value="Lambda Authorizer&#xa;&#xa;JWT検証&#xa;customerId取得"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="270" width="190" height="100" as="geometry"/>
        </mxCell>

        <!-- Submit Lambda -->
        <mxCell id="submitLambda" value="Job Submit Lambda&#xa;&#xa;・jobId生成&#xa;・status = QUEUED&#xa;・SQS登録"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="420" width="190" height="120" as="geometry"/>
        </mxCell>

        <!-- Job DB -->
        <mxCell id="jobDb" value="DynamoDB&#xa;BedrockJobs&#xa;&#xa;jobId&#xa;customerId&#xa;status&#xa;input&#xa;result&#xa;errorMessage"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="930" y="390" width="210" height="180" as="geometry"/>
        </mxCell>

        <!-- SQS -->
        <mxCell id="sqs" value="Amazon SQS&#xa;&#xa;Bedrock Job Queue"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;"
          vertex="1" parent="1">
          <mxGeometry x="930" y="640" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- Worker -->
        <mxCell id="worker" value="Worker Lambda&#xa;&#xa;1. status=PROCESSING&#xa;2. Bedrock呼び出し&#xa;3. 結果保存&#xa;4. SUCCEEDED / FAILED"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="1210" y="610" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrock" value="Amazon Bedrock&#xa;&#xa;Converse / InvokeModel&#xa;&#xa;最大 約3分"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="1210" y="350" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Get Job Lambda -->
        <mxCell id="getLambda" value="Job Get Lambda&#xa;&#xa;・Job状態取得&#xa;・customerId照合&#xa;・result返却"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="600" width="190" height="120" as="geometry"/>
        </mxCell>

        <!-- DLQ -->
        <mxCell id="dlq" value="Dead Letter Queue&#xa;&#xa;処理失敗メッセージ"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="1210" y="820" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- AUTH FLOW -->
        <mxCell id="e1" value="① POST /auth&#xa;maintenanceKey"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"
          edge="1" parent="1" source="wpf" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="/auth"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="api" target="authLambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="保守キー・顧客照合"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="authLambda" target="customerDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="JWT"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="authLambda" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- JOB SUBMIT -->
        <mxCell id="e5" value="② POST /jobs&#xa;Authorization: Bearer JWT&#xa;input"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="wpf" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" value="JWT検証"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="api" target="authorizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" value="認証OK"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="authorizer" target="submitLambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" value="Job登録&#xa;QUEUED"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="submitLambda" target="jobDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e9" value="jobId"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="submitLambda" target="sqs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e10" value="202 Accepted&#xa;jobId / QUEUED"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="submitLambda" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ASYNC -->
        <mxCell id="e11" value="非同期実行"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="sqs" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e12" value="Converse / InvokeModel"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="worker" target="bedrock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e13" value="生成結果"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="bedrock" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e14" value="PROCESSING →&#xa;SUCCEEDED / FAILED&#xa;result保存"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="worker" target="jobDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e15" value="一定回数失敗"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="worker" target="dlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- JOB GET -->
        <mxCell id="e16" value="③ GET /jobs/{jobId}&#xa;Authorization: Bearer JWT"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="wpf" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e17" value="認証済みRequest"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="api" target="getLambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e18" value="Job取得&#xa;customerId照合"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;"
          edge="1" parent="1" source="getLambda" target="jobDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e19" value="status / result"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="jobDb" target="getLambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e20" value="200 OK&#xa;QUEUED / PROCESSING /&#xa;SUCCEEDED / FAILED"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;"
          edge="1" parent="1" source="getLambda" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="note1"
          value="非同期処理&#xa;&#xa;POST /jobs ではBedrock完了を待たず、&#xa;jobIdを発行して 202 Accepted を即返却する。"
          style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="note2"
          value="認可&#xa;&#xa;GET /jobs/{jobId} では&#xa;JWT.customerId と Job.customerId を照合する。"
          style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="300" height="110" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>