    subgraph D["D. Asynchronous Job"]
        D1[".NET Desktop App"]
        D2["API Gateway"]
        D3["API Lambda"]
        D4["Amazon SQS"]
        D5["Worker Lambda"]
        D6["Amazon Bedrock"]
        D7["DynamoDB"]

        D1 -->|"POST /bedrock"| D2
        D2 --> D3
        D3 -->|"Register Job"| D4
        D3 -->|"202 + jobId"| D1

        D4 --> D5
        D5 --> D6
        D6 --> D5
        D5 -->|"Save Result"| D7

        D1 -->|"GET /jobs/{jobId}"| D2
        D2 --> D3
        D3 --> D7
        D7 --> D3
        D3 --> D1
    end


